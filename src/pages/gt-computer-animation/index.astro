---
// Placeholder landing for GITTACA (GT TA toolkit extension). Unlisted like the
// privacy page: direct URL only, noindex + sitemap-filtered. Install links get
// filled in once the Chrome Web Store / AMO items exist.
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
---

<Base
  title="GITTACA"
  description="Teaching-assistant toolkit browser extension for Georgia Tech courses."
  noindex
>
  <Section index="§" title="GITTACA" meta="TA toolkit · unlisted">
    <div class="landing" data-pagefind-ignore>
      <p class="landing__lead">
        A teaching-assistant toolkit for Georgia Tech computer animation courses: Vocareum grading,
        and reusable templates for Slack, Ed Discussion, Canvas, and Discord — all local, nothing
        phoned home.
      </p>
      <p class="landing__note">
        Internal tool, distributed unlisted. Install links arrive when the store listings go live.
        See the
        <a href="/gt-computer-animation/privacy/">privacy policy</a>.
      </p>
    </div>
  </Section>
</Base>

<style>
  .landing {
    max-width: 68ch;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .landing__lead {
    font-size: var(--step-1);
  }
  .landing__note {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
</style>
