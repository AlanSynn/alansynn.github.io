---
// Section.astro: section wrapper with a mono head (index + title + meta).
// Numbered because these are real sequences (CV timeline, pubs-by-year).
import CouplerCurve from './CouplerCurve.astro';

interface Props {
  index?: string; // e.g. "02"
  title: string;
  meta?: string; // right-aligned mono caption
  id?: string;
  divider?: boolean; // render coupler divider above
  /* Standalone pages (/blog, /search) pass "h1": their page title must be the
     document's single top-level heading. Homepage sections keep the default
     h2: the hero h1 is already the page's one h1. Both tags share the same
     .section-head__title class styling, so the swap is visually inert. */
  headingLevel?: 'h1' | 'h2';
}
const { index, title, meta, id, divider = false, headingLevel = 'h2' } = Astro.props;
const HeadingTag = headingLevel;
---

{divider && (
  <div class="coupler-divider">
    <CouplerCurve />
  </div>
)}
<section class="section" id={id}>
  <header class="section-head">
    {index && <span class="section-head__index">§ {index}</span>}
    <HeadingTag class="section-head__title">{title}</HeadingTag>
    {meta && <span class="section-head__meta">{meta}</span>}
  </header>
  <slot />
</section>
