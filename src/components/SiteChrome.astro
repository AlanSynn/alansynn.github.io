---
// SiteChrome.astro — reading-progress, back-to-top, lightbox. Progressive enhancement.
---

<div class="reading-progress" id="reading-progress" aria-hidden="true"></div>

<button
  class="back-to-top"
  id="back-to-top"
  type="button"
  aria-label="Back to top"
  title="Back to top"
>
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 19V5M5 12l7-7 7 7"></path>
  </svg>
</button>

<div class="lightbox" id="lightbox" aria-hidden="true">
  <button class="lightbox__close" id="lightbox-close" aria-label="Close">✕</button>
  <img id="lightbox-img" alt="" />
</div>

<script is:inline>
  // ONE persistent bootstrap (guarded — this IIFE executes once per session).
  // The bug this shape avoids: the original IIFE captured #reading-progress,
  // #back-to-top and #lightbox from the FIRST page's DOM; after any View-
  // Transition swap the closures pointed at detached nodes — the progress bar
  // froze, back-to-top never appeared, the lightbox silently no-oped (same
  // family as the Toc swap bug). Two rules keep every page live:
  //   1. Persistent window/document listeners are registered exactly once and
  //      read ONLY live state — per-page elements are held in variables that
  //      astro:page-load re-captures, and the lightbox queries fresh per event.
  //   2. Element-scoped bindings (back-to-top click, reveal observers) are
  //      re-bound on every astro:page-load; they die with the swapped DOM, so
  //      they never stack. Reveal uses a data-reveal-init guard so the initial
  //      load's double fire (immediate + page-load) is absorbed.
  (function () {
    if (window.__siteChromeBound) return;
    window.__siteChromeBound = true;

    /* reading progress + back to top — bar/btn re-captured per swap */
    var bar = null;
    var btn = null;
    function captureChrome() {
      bar = document.getElementById('reading-progress');
      var nextBtn = document.getElementById('back-to-top');
      if (nextBtn && nextBtn !== btn) {
        nextBtn.addEventListener('click', function () {
          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
        });
      }
      btn = nextBtn;
    }
    function onScroll() {
      var h = document.documentElement;
      var scrolled = h.scrollTop || document.body.scrollTop;
      var height = h.scrollHeight - h.clientHeight;
      if (bar && height > 0) bar.style.transform = 'scaleX(' + scrolled / height + ')';
      if (btn) btn.classList.toggle('visible', scrolled > 600);
    }
    window.addEventListener('scroll', onScroll, { passive: true });

    /* lightbox for prose images — delegation + fresh queries, never stale */
    function openLightbox(src, alt) {
      var lb = document.getElementById('lightbox');
      var lbImg = document.getElementById('lightbox-img');
      if (!lb || !lbImg) return;
      lbImg.src = src;
      lbImg.alt = alt || '';
      lb.classList.add('open');
      lb.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
    function closeLightbox() {
      var lb = document.getElementById('lightbox');
      if (!lb) return;
      lb.classList.remove('open');
      lb.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
    document.addEventListener('click', function (e) {
      var img = e.target.closest && e.target.closest('.prose img, .lightbox-target');
      if (img && img.src) {
        e.preventDefault();
        openLightbox(img.src, img.alt);
        return;
      }
      var lb = e.target.closest && e.target.closest('#lightbox');
      if (lb && (e.target === lb || (e.target.closest && e.target.closest('.lightbox__close')))) {
        closeLightbox();
      }
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeLightbox();
    });

    /* scroll reveal (IO) — fresh per page, guarded against double init */
    function initReveals(scope) {
      var reveals = (scope || document).querySelectorAll('[data-reveal]:not([data-reveal-init])');
      if (!reveals.length) return;
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (en) {
              if (en.isIntersecting) {
                var el = en.target;
                var delay = el.getAttribute('data-reveal-delay');
                if (delay) el.style.transitionDelay = delay + 'ms';
                el.classList.add('in');
                io.unobserve(el);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        for (var i = 0; i < reveals.length; i++) {
          reveals[i].setAttribute('data-reveal-init', '');
          io.observe(reveals[i]);
        }
      } else {
        for (var j = 0; j < reveals.length; j++) {
          reveals[j].classList.add('in');
        }
      }
    }

    captureChrome();
    initReveals(document);
    onScroll();

    // Per-swap re-init. astro:page-load fires on every client-side navigation,
    // including the first — the guards above keep re-entry a no-op.
    document.addEventListener('astro:page-load', function () {
      captureChrome();
      initReveals(document);
      onScroll(); // sync bar/button to the restored scroll position
    });

    // swapRootAttributes re-copies the served HTML's `no-js` class onto <html>
    // on every swap; the theme script that strips it is content-deduped after
    // first load. Strip it again BEFORE paint so reveal elements never sit
    // visible-then-animate (html.no-js is the fail-safe, not the goal).
    document.addEventListener('astro:after-swap', function () {
      document.documentElement.classList.remove('no-js');
    });
  })();
</script>
