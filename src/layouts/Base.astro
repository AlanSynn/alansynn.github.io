---
// Base.astro — document shell. Headerless (single-page CV); theme toggle replaces nav.
import '../styles/main.css';
import { ClientRouter } from 'astro:transitions';
import ThemeToggle from '../components/ThemeToggle.astro';
import SiteChrome from '../components/SiteChrome.astro';
import RobotArm from '../components/RobotArm.astro';
import RobotIK from '../components/RobotIK.astro';
import { site, type Paper } from '@/lib/data';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
  /* set false to render <main> without the centered container wrapper */
  contained?: boolean;
  /* present on academic paper pages → emit Google-Scholar citation_* meta and a
     ScholarlyArticle JSON-LD, and override OG/Twitter to the paper. */
  paper?: Paper;
  /* present on blog posts → emit a BlogPosting JSON-LD (mirrors the paper
     branch's shape: headline/author/dates/mainEntityOfPage) and set OG type to
     'article'. Blog falls through to this; without it, a post page gets the
     homepage's Person JSON-LD and a 'website' OG type. */
  article?: ArticleMeta;
  /* emit <meta name="robots" content="noindex, nofollow">. Passed from
     [...slug].astro as `post.data.draft` so reachable-but-unreleased draft posts
     are never indexed — parity with project `unlisted` (MicrositeShell noindex).
     The sitemap filter (astro.config.mjs) also drops draft URLs. */
  noindex?: boolean;
  /* Page-specific share image (root-relative or absolute). Work-project pages
     pass their frontmatter `image`; paper pages use paper.preview instead, and
     everything else falls back to the site-default og.png. */
  image?: string;
  /* The homepage passes this: the page IS the person's profile, so its JSON-LD
     is a Google-supported ProfilePage wrapping the Person (bare `Person` alone
     never triggers a rich result). Other non-article pages keep the plain
     Person node — valid entity data without claiming to be a profile page. */
  profile?: boolean;
}
const {
  title,
  description,
  wide = false,
  contained = true,
  paper,
  article,
  noindex,
  image,
  profile,
} = Astro.props;

interface ArticleMeta {
  headline: string;
  description?: string;
  datePublished?: string; // ISO 8601; Google's primary Article field
  dateModified?: string; // ISO 8601; only when a post carries updatedDate
  authorName?: string; // post author (defaults to site.name in the JSON-LD)
  keywords?: string[]; // post tags → BlogPosting `keywords` (SEO/LLM topicality)
}

const pageTitle = title
  ? `${title} - ${site.short_name}`
  : (site.browser_title ?? `${site.name} · ${site.title}`);
const desc = description ?? paper?.abstract ?? site.description;
const year = new Date().getFullYear();

const sameAs = (site.socials ?? [])
  .map((s: { url: string }) => s.url)
  .filter((u: string) => !u.startsWith('mailto:'))
  // sameAs must be absolute: the CV social entry is a root-relative path.
  .map((u: string) => (/^https?:\/\//.test(u) ? u : `${site.url}${u}`));

// Absolute-URL guard: pass through http(s)/protocol-relative URLs unchanged,
// prefix root-relative paths with the site origin. Avoids double-prefix if a
// field is ever absolute (e.g. an arXiv PDF).
const abs = (u?: string | null) =>
  u ? (/^(https?:)?\/\//.test(u) ? u : `${site.url}${u}`) : undefined;
// Site-default social image = the robot-motif composite (public/og.png,
// rasterized from public/og.svg: arm rising bottom-left, legs hanging
// top-right). Paper pages override with their own `preview`; project pages
// carry their own image in MicrositeShell. Everything else — home, /blog,
// /search, individual posts — falls back to this.
const defaultOg = abs('/og.png');
const canonical = new URL(Astro.url.pathname, site.url).href;
// Scholar prefers YYYY/MM (or YYYY/MM/DD); fall back to bare year.
const citeDate =
  paper && paper.year && paper.month
    ? `${paper.year}/${String(paper.month).padStart(2, '0')}`
    : paper?.year
      ? String(paper.year)
      : undefined;

// ScholarlyArticle for paper pages; BlogPosting for blog posts; Person (or the
// homepage's ProfilePage wrapping it) for everything else. The branch keeps
// each page type's structured data honest — a blog post is an Article, not a
// Person.
// The site owner as a schema.org entity. `@id` gives it a stable identity that
// other pages' JSON-LD can point at (BlogPosting author does, via the
// conditional below). Real profile photo, not the og composite — entity
// identity wants a face. alternateName carries BOTH public name variants so
// queries on the legal name ("DoangJoo Synn") resolve to the same entity.
const legalName = `${site.first_name} ${site.last_name}`;
const personNode = {
  '@type': 'Person',
  '@id': `${site.url}/#person`,
  name: site.name,
  alternateName: [site.short_name, legalName],
  description: site.description,
  jobTitle: site.title,
  url: site.url,
  image: `${site.url}/profile-photo.webp`,
  worksFor: { '@type': 'Organization', name: site.affiliation },
  subjectOf: { '@type': 'WebSite', url: site.url },
  ...(site.keywords?.length ? { knowsAbout: site.keywords } : {}),
  sameAs,
};
// Top-level WebSite node — Google's site-name SERP feature reads `name`/
// `alternateName` from exactly this shape (the nested Person.subjectOf node
// has no name and is ignored for it). Emitted alongside the ProfilePage.
const websiteNode = {
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  url: site.url,
  name: site.short_name,
  alternateName: [legalName],
  publisher: { '@id': `${site.url}/#person` },
};
const jsonld = paper
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ScholarlyArticle',
      headline: paper.title,
      description: paper.abstract ?? undefined,
      ...(paper.preview ? { image: abs(paper.preview) } : {}),
      author: paper.authors.map((a) => ({
        '@type': 'Person',
        ...(a.given ? { givenName: a.given } : {}),
        familyName: a.family,
        name: a.given ? `${a.given} ${a.family}` : a.family,
      })),
      datePublished:
        paper.year && paper.month
          ? `${paper.year}-${String(paper.month).padStart(2, '0')}`
          : paper.year
            ? `${paper.year}`
            : undefined,
      isAccessibleForFree: true,
      inLanguage: 'en',
      ...(paper.fields.publisher
        ? { publisher: { '@type': 'Organization', name: paper.fields.publisher } }
        : {}),
      ...(paper.venue ? { isPartOf: { '@type': 'PublicationEvent', name: paper.venue } } : {}),
      ...(paper.doi ? { sameAs: `https://doi.org/${paper.doi}` } : {}),
    })
  : article
    ? JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: article.headline,
        description: article.description ?? desc,
        author: {
          '@type': 'Person',
          name: article.authorName ?? site.name,
          url: site.url,
          // Entity-link the author to the homepage's ProfilePage node when the
          // author IS the site owner — Google uses @id links to attach recent
          // articles to the profile. A future guest author must NOT claim
          // that identity, so the id is conditional on the name.
          ...([site.name, site.short_name].includes(article.authorName ?? site.name)
            ? { '@id': `${site.url}/#person` }
            : {}),
        },
        // Personal blog → the publisher is the author (a Person), the schema-valid
        // choice when there's no publishing org.
        publisher: { '@type': 'Person', name: site.name, url: site.url },
        // Google's Article rich-result requires an image; posts have none of
        // their own, so the site-default composite carries it.
        image: defaultOg,
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
        // License + topical keywords: the machine-readable attribution trail.
        // (Papers above do NOT get this license — their copyright belongs to
        // the publisher; only the blog text is CC BY-NC-ND.)
        license: 'https://creativecommons.org/licenses/by-nc-nd/4.0/',
        isAccessibleForFree: true,
        inLanguage: 'en',
        ...(article.keywords?.length ? { keywords: article.keywords.join(', ') } : {}),
        ...(article.datePublished ? { datePublished: article.datePublished } : {}),
        ...(article.dateModified ? { dateModified: article.dateModified } : {}),
      })
    : JSON.stringify(
        profile
          ? {
              // Google's supported rich-result type for a page that IS a
              // person's profile ("About me" pages are explicitly valid); bare
              // Person never triggers a rich result. dateCreated/dateModified
              // are recommended but omitted — the template has no honest value
              // for them, and wrong dates are worse than none.
              '@context': 'https://schema.org',
              '@type': 'ProfilePage',
              '@id': canonical,
              mainEntity: personNode,
            }
          : { '@context': 'https://schema.org', ...personNode },
      );

// Harden the JSON-LD against inline-script breakout: JSON.stringify escapes
// quotes/backslashes but NOT `<`, so a paper title, venue, or author containing
// `</script>` would terminate this <script> early. Replacing `<` with its JSON
// unicode escape is the standard mitigation — JSON parsers still decode it to
// `<`, but the HTML tokenizer sees no closing tag. (Paper/blog content is
// first-party, but the hardening is cheap and removes the footgun for good.)
const jsonldSafe = jsonld.replace(/</g, '\\u003c');

// OG/Twitter: paper teaser (absolute) on paper pages; explicit page image
// (work projects) next; otherwise the site-default robot-composite og.png.
const ogTitle = paper ? paper.title : (article?.headline ?? pageTitle);
const ogImage = abs(paper?.preview) ?? abs(image) ?? defaultOg;
// The default card's dimensions are known (public/og.png is 1200×630); any
// override image has its own aspect, so dimensions are only declared for it.
const ogImageIsDefault = ogImage === defaultOg;
const ogType = paper || article ? 'article' : 'website';
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/favicon.svg" color="#1d4e89" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    {site.keywords?.length ? <meta name="keywords" content={site.keywords.join(', ')} /> : null}

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.short_name} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={ogImage} />
    {ogImageIsDefault && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta property="og:image:alt" content={ogTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogTitle} />

    {/* Google-Scholar indexing (academic paper pages only). */}
    {paper && (
      <>
        <meta name="citation_title" content={paper.title} />
        {paper.authors.map((a) => (
          <meta name="citation_author" content={a.given ? `${a.family}, ${a.given}` : a.family} />
        ))}
        {citeDate && <meta name="citation_publication_date" content={citeDate} />}
        <meta name="citation_conference_title" content={paper.venue} />
        {paper.doi && <meta name="citation_doi" content={paper.doi} />}
        {paper.abstract && <meta name="citation_abstract" content={paper.abstract} />}
        {paper.pdf && <meta name="citation_pdf_url" content={abs(paper.pdf)} />}
      </>
    )}

    <link rel="canonical" href={canonical} />
    <!-- robots: drafts/unlisted get noindex; indexable pages explicitly opt
         into large image previews (Google Images) + unrestricted snippets. -->
    <meta
      name="robots"
      content={
        noindex
          ? 'noindex, nofollow'
          : 'max-image-preview:large, max-snippet:-1, max-video-preview:-1'
      }
    />
    <ClientRouter />
    <script is:inline type="application/ld+json" set:html={jsonldSafe}></script>
    {profile && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(websiteNode).replace(/</g, '\\u003c')}
      ></script>
    )}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.short_name} - Blog`}
      href="/rss.xml"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Hanken+Grotesk:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    {/* Manrope — only on academic paper pages (the microsite port design). */}
    {paper && (
      <link
        href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
      />
    )}
    <link
      rel="stylesheet"
      href="https://fred-wang.github.io/MathFonts/NewComputerModern/mathfonts.css"
    />

    <script is:inline>
      // No-flash theme init: resolve stored pref or system preference BEFORE paint.
      // `applyTheme` is also re-run on every View-Transition swap via the
      // persistent `astro:after-swap` listener below. Without that re-run, the
      // `data-theme` attribute (set here at runtime, not in the HTML source) is
      // lost when the ClientRouter swaps to/from the isolated MicrositeShell
      // (academic project pages — no theme script of their own), and the
      // `:root:not([data-theme])` + `prefers-color-scheme: dark` fallback in
      // tokens.css flips the site dark regardless of the stored choice. The
      // listener is registered once on first load and survives all client-side
      // navs (the ClientRouter keeps the same `document`), so it fires on every
      // swap — before paint, so there's no flash.
      (function () {
        document.documentElement.classList.remove('no-js'); // JS is on -> reveal animations active
        function applyTheme() {
          try {
            var t = localStorage.getItem('theme');
            if (!t) t = 'light'; // default to light
            document.documentElement.setAttribute('data-theme', t);
          } catch (e) {
            document.documentElement.setAttribute('data-theme', 'light');
          }
        }
        applyTheme();
        // Guard: the is:inline IIFE may re-run on some ClientRouter swap paths;
        // register the swap listener once so it can't accumulate. applyTheme is
        // idempotent regardless, but this keeps the listener list to one entry.
        if (!window.__themeListenerBound) {
          window.__themeListenerBound = true;
          document.addEventListener('astro:after-swap', applyTheme);
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <main id="main" class:list={[paper && 'main--project']} data-pagefind-body tabindex="-1">
      {contained ? (
        <div class:list={['container', wide && 'container--wide']}>
          <slot />
        </div>
      ) : (
        <slot />
      )}
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <a class="site-footer__copy" href="https://github.com/AlanSynn/alansynn.github.io#license">
          © {year} {site.short_name}
        </a>
        <nav class="site-footer__path" aria-label="Site">
          <a href="/">{site.domain}</a>
          <span class="site-footer__sep" aria-hidden="true">
            /
          </span>
          <a href="/blog">blog</a>
          <span class="site-footer__sep" aria-hidden="true">
            /
          </span>
          <a href="/press">press</a>
        </nav>
        <ThemeToggle />
      </div>
      <RobotArm zone="floor" />
    </footer>
    <SiteChrome />
    <RobotIK />
  </body>
</html>
